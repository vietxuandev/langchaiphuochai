# Biến môi trường cho Docker Compose (copy thành .env rồi chỉnh nếu cần)

# Mật khẩu ký JWT - BẮT BUỘC đổi khi triển khai thật
JWT_SECRET="langchai-super-secret-doi-trong-production"

# Origin được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS="http://localhost:3000,https://langchaiphuochai.com"

# URL công khai của website (dùng cho SEO/metadata)
NEXT_PUBLIC_SITE_URL="https://langchaiphuochai.com"
