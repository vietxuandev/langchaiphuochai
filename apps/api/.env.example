# Kết nối PostgreSQL
DATABASE_URL="postgresql://phuochai:phuochai@localhost:55432/phuochai?schema=public"

# Bảo mật JWT
JWT_SECRET="doi-thanh-chuoi-bi-mat-that-dai-trong-production"
JWT_EXPIRES_IN="7d"

# Cổng và CORS
PORT=4000
CORS_ORIGINS="http://localhost:3000,https://langchaiphuochai.com"

# Thư mục ảnh upload của server mới (mặc định: <repo>/data/upload)
UPLOAD_DIR="../../data/upload"

# Đường dẫn file GraphQL schema sinh tự động
SCHEMA_PATH="schema.graphql"

# Bật log truy vấn Prisma (tuỳ chọn)
PRISMA_LOG=false

# --- Thông báo quản trị qua Telegram (tuỳ chọn) ---
# Để trống thì thông báo chỉ hiển thị in-app.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# URL dùng để tạo link trong tin nhắn Telegram
ADMIN_BASE_URL="http://localhost:3000"

# --- ISR / revalidate ---
# API gọi web nội bộ để làm mới trang sau khi publish/sửa/xoá
WEB_INTERNAL_URL="http://localhost:3000"
REVALIDATE_SECRET="doi-thanh-chuoi-bi-mat-revalidate"
