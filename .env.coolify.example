# =============================================================================
# Biến môi trường cho Coolify - dán vào: Resource → Environment Variables
# (Copy file này rồi đổi các giá trị bí mật)
# =============================================================================

# --- Bắt buộc: bí mật ---
# Tạo bằng: openssl rand -hex 32
JWT_SECRET=doi_thanh_chuoi_ngau_nhien_64_ky_tu
# Mật khẩu PostgreSQL (tự đặt, không dùng mặc định)
DB_PASSWORD=doi_thanh_mat_khau_manh

# --- Bắt buộc: thông tin database (giữ nguyên nếu không cần đổi) ---
DB_USER=phuochai
DB_NAME=phuochai

# --- Bắt buộc: domain và đường dẫn dữ liệu ---
NEXT_PUBLIC_SITE_URL=https://langchaiphuochai.com
CORS_ORIGINS=https://langchaiphuochai.com
# Thư mục trên HOST chứa dữ liệu (sẽ mount vào container):
#   <DATA_DIR>/upload  -> ảnh (/upload/...)
#   <DATA_DIR>/seed    -> dataset.json để import
DATA_DIR=/data/langchaiphuochai

# --- Tuỳ chọn: cổng ---
# Cổng app lắng nghe TRONG container. Đổi thì phải cập nhật ô "Ports Exposes" của
# service tương ứng trong Coolify UI (xem DEPLOY.md mục 12).
# API_INTERNAL_URL của web tự suy ra từ API_PORT, nhưng là biến build -> phải Deploy lại.
#WEB_PORT=3000
#API_PORT=4000

# --- Tuỳ chọn khác ---
JWT_EXPIRES_IN=7d

# Địa chỉ website cũ dùng cho tính năng "Crawl bài mới" trong trang quản trị.
# Mặc định https://phuochai.com - chỉ đổi nếu site cũ chuyển sang tên miền khác.
#LEGACY_SITE_URL=https://phuochai.com

# --- MCP server cho AI agent (Phase 1) ---
# URL công khai của MCP server (dùng trong resource metadata + WWW-Authenticate).
# Trỏ domain này về service api (port 4000) trong Coolify; hoặc dùng cùng domain api.
MCP_PUBLIC_URL=https://mcp.langchaiphuochai.com
# Cũng phải nhúng vào build của web để trang Token hiển thị đúng endpoint:
# NEXT_PUBLIC_MCP_URL phải khai báo trong Coolify (build variable) và compose.
NEXT_PUBLIC_MCP_URL=https://mcp.langchaiphuochai.com
MCP_ENABLED=true
MCP_RATE_LIMIT_PER_MIN=60
MCP_DAILY_POST_LIMIT=200
MCP_MAX_IMAGES_PER_POST=20
# Chỉ bật khi muốn agent tự xuất bản (khuyến nghị để false)
MCP_ALLOW_PUBLISH=false
# Chuỗi ngẫu nhiên thêm vào khi hash token (nên đặt, đổi thì mọi token cũ mất hiệu lực)
MCP_TOKEN_PEPPER=
# Host được phép gọi /mcp (thêm domain proxy nếu cần), phân tách bằng dấu phẩy
MCP_ALLOWED_HOSTS=

# --- Thông báo quản trị qua Telegram (tuỳ chọn) ---
# Tạo bot với @BotFather, lấy token; chat id có thể là group id (số âm).
# Để trống thì thông báo chỉ hiển thị in-app.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_BASE_URL=https://langchaiphuochai.com
